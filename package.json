{
  "name": "@yplusplus/bootstrap",
  "version": "0.1.0",
  "private": true,
  "description": "Y++ BOOT - experimental Yapper Desktop bootstrap and preload patcher",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "inspect": "tsx src/cli.ts inspect",
    "patch": "tsx src/cli.ts patch",
    "restore": "tsx src/cli.ts restore",
    "launch": "tsx src/cli.ts launch",
    "test": "tsx --test test/*.test.ts test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "install-managed": "npm run build && node dist/cli.js install",
    "check-updates": "tsx src/cli.ts check-updates",
    "update-managed": "npm run build && node dist/cli.js update"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
